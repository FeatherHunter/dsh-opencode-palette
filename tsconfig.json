{
  // P3：全仓手写源码（src/engine、scripts、runtime、tests、types）均已 .ts，类型检查（noEmit）覆盖全量。
  // 不再需要 allowJs/checkJs（没有未迁的 .mjs 进模块图；prototypes/ 按 D6 排除在 include 之外）。
  // 存量错误台账收口：P1 在 HEAD 上实测 ≈1,370 条 / 26 类（tests 577、runtime 449、src/engine 185、scripts 158），
  // 分批清零——engine/scripts 在 P2、runtime/tests 在 P3；当初 runtime/client.mjs 的 9 条 TS2307 伪路径
  // 已随 P3 改成真实相对路径（'../src/engine/*.ts'）消失。
  // typescript 钉 5.9.3：票面 5.6 无 erasableSyntaxOnly（5.8+）/rewriteRelativeImportExtensions（5.7+），最低需 5.8。
  // target 取 ES2022（105 §7.2 的口径），不跟 106 基线的 esnext：发布目标是 Node>=22.18 与浏览器 ES2022，
  // 本仓也没有 esnext-only 语法；strict 从第一天就开，.ts 不留后补债。
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    // base 包入口的类型垫片（types/base-client.d.ts / types/base-node.d.ts）：上游 d.ts 用无扩展名相对导入，
    // NodeNext 下报 TS2834；本仓不开 skipLibCheck，故用 paths 精准覆盖这两个 specifier，其余模块解析不变。
    // 运行时仍解析真实包，垫片只镜像本仓用到的类型面。
    "paths": {
      "dsh-featherhunter-plugin-base/client": ["./types/base-client.d.ts"],
      "dsh-featherhunter-plugin-base/node": ["./types/base-node.d.ts"]
    },
    // 106 基线条目：import type 等按官方基线书写，迁 TS 时不会退化成运行时导入。
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    // 不开 skipLibCheck：唯一的 types/dsh.d.ts 必须被检查，否则声明内部写错也会静默通过。
    "forceConsistentCasingInFileNames": true,
    // Node 原生类型剥离 + tsc 只转译的约束：只允许可擦除语法；相对导入允许写 .ts 并重写为 .js。
    "erasableSyntaxOnly": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["types/**/*.ts", "src/**/*.ts", "scripts/**/*.ts", "runtime/**/*.ts", "tests/**/*.ts"]
}
