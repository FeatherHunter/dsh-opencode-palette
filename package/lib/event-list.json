{
  "version": 1,
  "pluginId": "dsh-opencode-palette",
  "events": {
    "host.call": {
      "level": "info",
      "kind": "resident",
      "fields": [
        "method",
        "latencyMs",
        "ok",
        "kind",
        "pluginId"
      ]
    },
    "host.call.fail": {
      "level": "warn",
      "kind": "resident",
      "fields": [
        "method",
        "kind",
        "errorHash",
        "pluginId"
      ]
    },
    "update.install.exec": {
      "level": "info",
      "kind": "resident",
      "fields": [
        "route",
        "ok",
        "exitCode",
        "durationMs",
        "pluginId"
      ]
    },
    "update.wire.ready": {
      "level": "info",
      "kind": "resident",
      "fields": [
        "logSink",
        "logDirHash"
      ]
    },
    "update.check.done": {
      "level": "info",
      "kind": "resident",
      "fields": [
        "ok",
        "current",
        "latest",
        "channel",
        "source",
        "latencyMs"
      ]
    },
    "update.check.fail": {
      "level": "warn",
      "kind": "resident",
      "fields": [
        "stage",
        "errorKind",
        "httpStatus"
      ]
    },
    "update.status.changed": {
      "level": "info",
      "kind": "resident",
      "fields": [
        "kind",
        "latest"
      ]
    },
    "update.install.request": {
      "level": "info",
      "kind": "resident",
      "fields": [
        "from",
        "current",
        "latest",
        "checkAgeMs"
      ]
    },
    "update.install.verify": {
      "level": "info",
      "kind": "resident",
      "fields": [
        "result",
        "installedVersion",
        "pendingRestart"
      ]
    },
    "update.batch.entry.request": {
      "level": "info",
      "kind": "resident",
      "fields": [
        "total",
        "ownCount",
        "foreignCount"
      ]
    },
    "update.batch.entry.fail": {
      "level": "warn",
      "kind": "resident",
      "fields": [
        "targetHash",
        "errorKind",
        "exitCode"
      ]
    },
    "update.batch.summary": {
      "level": "info",
      "kind": "resident",
      "fields": [
        "total",
        "ok",
        "failed",
        "skipped",
        "durationMs"
      ]
    },
    "update.queue.transition": {
      "level": "info",
      "kind": "resident",
      "fields": [
        "phase",
        "waitedMs",
        "position"
      ]
    },
    "update.lock.anomaly": {
      "level": "warn",
      "kind": "resident",
      "fields": [
        "kind",
        "ageMs",
        "ownerHash"
      ]
    },
    "update.store.fail": {
      "level": "warn",
      "kind": "resident",
      "fields": [
        "op",
        "reason",
        "dirHash"
      ]
    },
    "update.panel.mount": {
      "level": "info",
      "kind": "resident",
      "fields": [
        "mode",
        "theme",
        "lang",
        "pollMs"
      ]
    },
    "update.panel.action": {
      "level": "info",
      "kind": "resident",
      "fields": [
        "action",
        "bytes",
        "truncated"
      ]
    },
    "update.panel.render.fail": {
      "level": "error",
      "kind": "resident",
      "fields": [
        "kind"
      ]
    },
    "update.check.start": {
      "level": "info",
      "kind": "ondemand",
      "fields": [
        "trigger",
        "source"
      ]
    },
    "update.registry.fetch": {
      "level": "info",
      "kind": "ondemand",
      "fields": [
        "httpStatus",
        "latencyMs",
        "registryHost"
      ]
    },
    "update.channel.decide": {
      "level": "info",
      "kind": "ondemand",
      "fields": [
        "channel",
        "reason",
        "from",
        "to"
      ]
    },
    "update.changelog.parse": {
      "level": "info",
      "kind": "ondemand",
      "fields": [
        "entries",
        "truncated",
        "degraded",
        "source"
      ]
    },
    "update.poll": {
      "level": "info",
      "kind": "ondemand",
      "fields": [
        "state",
        "latencyMs"
      ]
    },
    "update.lang.applied": {
      "level": "info",
      "kind": "ondemand",
      "fields": [
        "lang",
        "source"
      ]
    },
    "update.panel.state": {
      "level": "info",
      "kind": "ondemand",
      "fields": [
        "state",
        "theme",
        "tokensApplied",
        "fallback"
      ]
    },
    "update.log.degraded": {
      "level": "warn",
      "kind": "selfmon",
      "fields": [
        "reason"
      ]
    },
    "log.switch.set": {
      "level": "info",
      "kind": "resident",
      "fields": [
        "enabled",
        "ok",
        "reason",
        "pluginId"
      ]
    },
    "log.forward.summary": {
      "level": "warn",
      "kind": "resident",
      "fields": [
        "droppedDelta",
        "totalDropped",
        "reason",
        "windowMs"
      ]
    },
    "log.switch.watchdog": {
      "level": "warn",
      "kind": "resident",
      "fields": [
        "op",
        "timeoutMs",
        "stage"
      ]
    },
    "log.export.fail": {
      "level": "warn",
      "kind": "resident",
      "fields": [
        "op",
        "reason",
        "errorHash"
      ]
    },
    "host.channel.fail": {
      "level": "error",
      "kind": "resident",
      "fields": [
        "stage",
        "path",
        "reason"
      ]
    }
  }
}
