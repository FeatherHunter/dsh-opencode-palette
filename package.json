{
  "name": "dsh-opencode-palette",
  "version": "1.7.2",
  "private": true,
  "description": "DSH Web 多主题引擎：完整支持 opencode 全部 38 个主题（37 内置：33 TUI + 4 桌面 2.0 + system）。数据驱动三层管线：主题 JSON → 颜色解析 → DSH 适配注入。",
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync-themes.mjs",
    "fonts": "node scripts/inline-fonts.mjs",
    "build": "node scripts/inline-fonts.mjs && node scripts/build-client.mjs",
    "test": "node --test tests/engine.test.mjs tests/panel-render.test.mjs tests/update-panel.test.mjs"
  },
  "engines": { "node": ">=20" },
  "devDependencies": {
    "dsh-log": "0.2.1",
    "dsh-plugin-update": "0.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" }
  },
  "license": "MIT"
}