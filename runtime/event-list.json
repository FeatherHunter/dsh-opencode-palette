{
  "version": 1,
  "pluginId": "dsh-opencode-palette",
  "events": {
    "host.call": {
      "level": "info",
      "kind": "resident",
      "fields": [
        "method",
        "latencyMs",
        "ok",
        "kind",
        "pluginId"
      ]
    },
    "host.call.fail": {
      "level": "warn",
      "kind": "resident",
      "fields": [
        "method",
        "kind",
        "error",
        "errorHash",
        "pluginId"
      ]
    },
    "update.install.exec": {
      "level": "info",
      "kind": "resident",
      "fields": [
        "route",
        "ok",
        "exitCode",
        "durationMs",
        "pluginId"
      ]
    },
    "update.wire.ready": {
      "level": "info",
      "kind": "resident",
      "fields": [
        "logSink",
        "logDirHash",
        "updaterVersion",
        "copyLevel",
        "hostKind"
      ]
    },
    "update.check.done": {
      "level": "info",
      "kind": "resident",
      "fields": [
        "ok",
        "current",
        "latest",
        "channel",
        "source",
        "latencyMs",
        "blockedReason",
        "fallback",
        "dataSource",
        "pendingRestart",
        "jobState"
      ]
    },
    "update.check.fail": {
      "level": "warn",
      "kind": "resident",
      "fields": [
        "stage",
        "errorKind",
        "httpStatus",
        "latencyMs",
        "source"
      ]
    },
    "update.status.changed": {
      "level": "info",
      "kind": "resident",
      "fields": [
        "kind",
        "latest",
        "runningVersion",
        "installedVersion",
        "registered",
        "identity",
        "blockedReason",
        "unknownCause"
      ]
    },
    "update.install.request": {
      "level": "info",
      "kind": "resident",
      "fields": [
        "from",
        "current",
        "latest",
        "checkAgeMs",
        "intentHash"
      ]
    },
    "update.install.fail": {
      "level": "warn",
      "kind": "resident",
      "fields": [
        "stage",
        "reason",
        "code",
        "hostCodeHash",
        "check",
        "exitCode",
        "observedVersion",
        "intentHash"
      ]
    },
    "update.install.verify": {
      "level": "info",
      "kind": "resident",
      "fields": [
        "result",
        "installedVersion",
        "pendingRestart"
      ]
    },
    "update.batch.entry.request": {
      "level": "info",
      "kind": "resident",
      "fields": [
        "total",
        "ownCount",
        "foreignCount",
        "sessionHash"
      ]
    },
    "update.batch.entry.fail": {
      "level": "warn",
      "kind": "resident",
      "fields": [
        "targetHash",
        "sessionHash",
        "errorKind",
        "stage",
        "index",
        "exitCode"
      ]
    },
    "update.batch.summary": {
      "level": "info",
      "kind": "resident",
      "fields": [
        "total",
        "ok",
        "failed",
        "skipped",
        "durationMs",
        "sessionAgeMs",
        "resumed",
        "sessionHash",
        "stoppedBecause"
      ]
    },
    "update.batch.run.start": {
      "level": "info",
      "kind": "resident",
      "fields": [
        "trigger",
        "resumed",
        "total",
        "pending",
        "sessionHash"
      ]
    },
    "update.install.retry": {
      "level": "info",
      "kind": "resident",
      "fields": [
        "reason",
        "attempt",
        "requestHash"
      ]
    },
    "update.queue.transition": {
      "level": "info",
      "kind": "resident",
      "fields": [
        "phase",
        "waitedMs",
        "position",
        "holderHash"
      ]
    },
    "update.lock.anomaly": {
      "level": "warn",
      "kind": "resident",
      "fields": [
        "kind",
        "ageMs",
        "ownerHash"
      ]
    },
    "update.store.fail": {
      "level": "warn",
      "kind": "resident",
      "fields": [
        "op",
        "reason",
        "dirHash"
      ]
    },
    "update.panel.mount": {
      "level": "info",
      "kind": "resident",
      "fields": [
        "mode",
        "theme",
        "lang",
        "pollMs",
        "autoCheck"
      ]
    },
    "update.panel.action": {
      "level": "info",
      "kind": "resident",
      "fields": [
        "action",
        "bytes",
        "truncated",
        "ok",
        "errorKind",
        "durationMs",
        "errorHash"
      ]
    },
    "update.panel.render.fail": {
      "level": "error",
      "kind": "resident",
      "fields": [
        "kind",
        "phase",
        "errorHash"
      ]
    },
    "update.check.start": {
      "level": "info",
      "kind": "ondemand",
      "fields": [
        "trigger",
        "source"
      ]
    },
    "update.registry.fetch": {
      "level": "info",
      "kind": "ondemand",
      "fields": [
        "httpStatus",
        "latencyMs",
        "registryHost"
      ]
    },
    "update.channel.decide": {
      "level": "info",
      "kind": "ondemand",
      "fields": [
        "channel",
        "reason",
        "from",
        "to"
      ]
    },
    "update.changelog.parse": {
      "level": "info",
      "kind": "resident",
      "fields": [
        "version",
        "entries",
        "truncated",
        "degraded",
        "status",
        "cached",
        "source"
      ]
    },
    "update.poll": {
      "level": "info",
      "kind": "ondemand",
      "fields": [
        "state",
        "latencyMs"
      ]
    },
    "update.lang.applied": {
      "level": "info",
      "kind": "ondemand",
      "fields": [
        "lang",
        "source"
      ]
    },
    "update.panel.state": {
      "level": "info",
      "kind": "ondemand",
      "fields": [
        "state",
        "theme",
        "tokensApplied",
        "fallback"
      ]
    },
    "update.log.degraded": {
      "level": "warn",
      "kind": "selfmon",
      "fields": [
        "reason",
        "event",
        "field"
      ]
    },
    "log.switch.set": {
      "level": "info",
      "kind": "resident",
      "fields": [
        "enabled",
        "ok",
        "reason",
        "pluginId"
      ]
    },
    "log.forward.summary": {
      "level": "warn",
      "kind": "resident",
      "fields": [
        "droppedDelta",
        "totalDropped",
        "reason",
        "windowMs"
      ]
    },
    "log.switch.watchdog": {
      "level": "warn",
      "kind": "resident",
      "fields": [
        "op",
        "timeoutMs",
        "stage"
      ]
    },
    "log.export.fail": {
      "level": "warn",
      "kind": "resident",
      "fields": [
        "op",
        "reason",
        "errorHash"
      ]
    },
    "host.channel.fail": {
      "level": "error",
      "kind": "resident",
      "fields": [
        "stage",
        "path",
        "reason"
      ]
    }
  }
}
